{
  "compilerOptions": {
    "target": "ES2019",
    "lib": [
      "ES2019",
      "DOM"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "legacy",
    "rootDir": "old_src",
    "outDir": "data",
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "noEmitOnError": true
  },
  "include": [
    "old_src/**/*"
  ]
}
{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "legacy",
    "rootDir": "src",
    "outDir": "js",
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "noEmitOnError": true
  },
  "include": ["src/**/*"]
}
